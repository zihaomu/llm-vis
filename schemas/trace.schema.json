{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/DiagnosticSeverity"
        },
        "subject_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Id"
        }
      },
      "required": [
        "id",
        "severity",
        "code",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "DiagnosticSeverity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "DiagnosticSeverity",
      "type": "string"
    },
    "TraceCategory": {
      "enum": [
        "module_range",
        "operator",
        "fusion_group",
        "kernel",
        "memcpy",
        "synchronization",
        "allocator",
        "other"
      ],
      "title": "TraceCategory",
      "type": "string"
    },
    "TraceEvent": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/TraceCategory"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "counters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "number"
              }
            ]
          },
          "title": "Counters",
          "type": "object"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "duration": {
          "minimum": 0.0,
          "title": "Duration",
          "type": "number"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kernel_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kernel Name"
        },
        "parent_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "start": {
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "stream": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stream"
        }
      },
      "required": [
        "id",
        "category",
        "start",
        "duration"
      ],
      "title": "TraceEvent",
      "type": "object"
    }
  },
  "$id": "https://llm-vis.dev/schemas/v0.1/trace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Standalone trace artifact represented by ``trace.schema.json``.",
  "properties": {
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TraceEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "TraceDocument",
  "type": "object"
}
